# Copy to .env and load explicitly: set -a; source .env; set +a
# Replay/tests/mock mode never require credentials. Empty values are intentional.
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
KEV_BASE_URL=
KEV_MODEL=kev-latest
KEV_API_KEY=
KEV_REVISION=

# Live gateway (one worker only).
QUOTA_CORPUS=data/corpus.json
QUOTA_CAPACITY=3
QUOTA_WINDOW_S=10
QUOTA_POLICY=current_capacity
QUOTA_REQUIRED_ORDER=fifo
QUOTA_RESERVE=1
QUOTA_PREDICTOR=history
QUOTA_HISTORY=data/development.json
QUOTA_CONTEXT=progress
QUOTA_SAMPLES=16
QUOTA_HORIZON_S=30
QUOTA_MAX_CALLS=4
QUOTA_EPSILON=0.05
QUOTA_OVERHEAD_S=0.001
QUOTA_MODEL_TIMEOUT_S=2
QUOTA_DECISION_TIMEOUT_S=5
QUOTA_INPUT_USD_PER_MILLION=
QUOTA_OUTPUT_USD_PER_MILLION=

# Optional main QA agent: full chat-completions endpoint and chosen model.
# Separate from Jev/Kev, which predict demand rather than generate QA answers.
QA_CHAT_URL=
QA_MODEL=
QA_API_KEY=
# Set max_completion_tokens for endpoints that require that parameter.
QA_TOKEN_PARAMETER=max_tokens
QA_MAX_OUTPUT_TOKENS=512
QA_INPUT_USD_PER_MILLION=
QA_OUTPUT_USD_PER_MILLION=
